{
  "name": "strack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"bun run dev:web\" \"bun run dev:api\"",
    "dev:web": "bun vite",
    "dev:api": "bun run --hot backend/adapter/bun.ts",
    "build": "vue-tsc -b && vite build",
    "dev:cf": "vite build && bunx wrangler pages dev",
    "deploy:cf": "bun run build && bunx wrangler pages deploy",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hono/ua-blocker": "^0.1.42",
    "@tailwindcss/vite": "^4.3.3",
    "crypto-js": "^4.2.0",
    "hono": "^4.13.12",
    "hono-mem-cache": "^0.4.0",
    "ofetch": "^1.5.1",
    "pinia": "^4.0.3",
    "unstorage": "^1.17.5",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "@types/bun": "^1.4.2",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.147.0"
  }
}
